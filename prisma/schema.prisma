// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum OrganizationStatus {
  pending
  approved
  rejected
  archived
}

model Organization {
  id          Int                @id @default(autoincrement())
  name        String             @db.Text
  description String?            @db.Text
  websiteUrl  String?            @map("website_url")
  status      OrganizationStatus @default(pending)

  // === ПОЛЯ ДЛЯ ІМПОРТУ З XML (додані для парсера) ===
  // ЄДРПОУ організації (унікальне, використовується для пошуку під час оновлення)
  edrpou      String             @unique
  // Повна адреса організації (витягується з XML)
  address     String?            @db.Text
  // Юридичний статус організації з реєстру (наприклад "зареєстровано")
  legalStatus String?            @map("legal_status")
  // Імена засновників / контакти (зберігаємо як довгий текст)
  founders    String?            @db.Text
  // Директор / керівник (може бути кілька)
  director    String?            @db.Text
  // Організаційно-правова форма (наприклад "ТОВАРИСТВО З ОБМЕЖЕНОЮ ВІДПОВІДАЛЬНІСТЮ")
  organizationType String?       @map("organization_type") @db.Text
  // Дата реєстрації
  registrationDate String?       @map("registration_date") @db.Text
  // Коротка назва
  shortName   String?            @map("short_name") @db.Text
  // ====================================================

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason") @db.Text

  categories OrganizationCategory[]

  @@map("organizations")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  organizations OrganizationCategory[]

  @@map("categories")
}

model OrganizationCategory {
  organizationId Int @map("organization_id")
  categoryId     Int @map("category_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([organizationId, categoryId])
  @@map("organization_categories")
}
