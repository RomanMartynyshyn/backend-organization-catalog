root = true                      # цей файл є кореневим (більше не шукає конфіги вище)

[*]                              # застосовувати до всіх файлів

charset = utf-8                  # кодування файлів (UTF-8 — стандарт для Node.js)
end_of_line = lf                 # перенос рядка LF (Linux/macOS стиль, правильний для Git)
insert_final_newline = true      # додає пустий рядок в кінці файлу
indent_style = space             # відступи робляться пробілами (а не tab)
indent_size = 2                  # кількість пробілів у відступі = 2
trim_trailing_whitespace = true  # видаляє зайві пробіли в кінці рядків